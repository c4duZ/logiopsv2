<?xml version="1.0" encoding="UTF-8"?>
<node>
  <!--
    Trimmed introspection for the per device HiresScroll interface
    (features/HiresScroll.cpp), hosted on the device node. GetConfig returns the
    hires, invert and target flags. SetHires/SetInvert/SetTarget write each.
    (The up/down scroll gestures are gesture typed and belong to Phase 4; they
    are deliberately omitted here.) Type code: b bool. SCR 02.
  -->
  <interface name="pizza.pixl.LogiOps.HiresScroll">
    <method name="GetConfig">
      <arg name="hires" type="b" direction="out"/>
      <arg name="invert" type="b" direction="out"/>
      <arg name="target" type="b" direction="out"/>
    </method>
    <method name="SetHires">
      <arg name="hires" type="b" direction="in"/>
    </method>
    <method name="SetInvert">
      <arg name="invert" type="b" direction="in"/>
    </method>
    <method name="SetTarget">
      <arg name="target" type="b" direction="in"/>
    </method>
  </interface>
</node>
