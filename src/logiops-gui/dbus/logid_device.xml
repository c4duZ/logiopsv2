<?xml version="1.0" encoding="UTF-8"?>
<node>
  <!--
    Trimmed introspection for the daemon's per-device pizza.pixl.LogiOps.Device
    interface (lives on /pizza/pixl/logiops/devices/N). Hand-authored from the
    VERIFIED D-Bus surface (02-RESEARCH.md). Dev-time reference: introspect
    pizza.pixl.LogiOps at /pizza/pixl/logiops/devices/0 via busctl (xml-interface).

    Name (s, DEV-04), ProductID (q/uint16, mouse-vs-keyboard icon), Active
    (b, true=awake/false=sleeping, DEV-03) and the StatusChanged(b) signal exist
    in the daemon today.

    Battery (y/uint8 percentage RO, DEV-02), Charging (b RO), BatteryKnown
    (b RO) and the BatteryChanged(percentage y, charging b, known b) signal
    were added to the daemon by Plan 02 (HID++ 0x1004 UnifiedBattery preferred,
    0x1000 BatteryStatus fallback; both feed Device::setBattery). Plan 05 adds
    them here and wires DaemonConnection -> DeviceModel.onBatteryChanged so the
    battery block is live + signal-driven (no polling, CONF-03). Names/types
    verified against src/logid/Device.cpp (the .Device IPC property/signal map).
  -->
  <interface name="pizza.pixl.LogiOps.Device">
    <property name="Name" type="s" access="read"/>
    <property name="ProductID" type="q" access="read"/>
    <property name="Active" type="b" access="read"/>
    <property name="Battery" type="y" access="read"/>
    <property name="Charging" type="b" access="read"/>
    <property name="BatteryKnown" type="b" access="read"/>
    <signal name="StatusChanged">
      <arg name="active" type="b"/>
    </signal>
    <signal name="BatteryChanged">
      <arg name="percentage" type="y"/>
      <arg name="charging" type="b"/>
      <arg name="known" type="b"/>
    </signal>

    <!--
      Profile + restore surface (Plan 04, PROF-01 / CONF-02). GetProfiles returns
      the manual profile names; SetProfile(name) creates-if-absent + switches live;
      RemoveProfile deletes one; ClearProfile resets the named profile to defaults
      and reconfigures the hardware (restore). ActiveProfile / DefaultProfile are
      read-only string properties. VERIFIED src/logid/Device.cpp:340-355. These live
      on the SAME PizzaPixlLogiOpsDeviceInterface so there is one device proxy class
      (ProfilesModel + ConfigState reuse it).
    -->
    <method name="GetProfiles">
      <arg name="profiles" type="as" direction="out"/>
    </method>
    <method name="SetProfile">
      <arg name="profile" type="s" direction="in"/>
    </method>
    <method name="RemoveProfile">
      <arg name="profile" type="s" direction="in"/>
    </method>
    <method name="ClearProfile">
      <arg name="profile" type="s" direction="in"/>
    </method>
    <property name="ActiveProfile" type="s" access="read"/>
    <property name="DefaultProfile" type="s" access="read"/>
  </interface>
</node>
